# =============================================================================
#  Lista de Jogos — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA faça commit do .env.local (ele já está no .gitignore).
# =============================================================================

# --- Banco de dados (Neon) -----------------------------------------------------
# Painel do Neon → seu projeto → Connect → copie a connection string
# (a versão "pooled", com "-pooler" no host, é a recomendada para a Vercel).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js -------------------------------------------------------------------
# Segredo usado para assinar/criptografar o JWT da sessão.
# Gere com:  npx auth secret   ou   openssl rand -base64 33
AUTH_SECRET=""

# Necessário para `npm run build && npm start` local ou hospedagem fora da Vercel.
# (Na Vercel e no `npm run dev` já é automático.)
# AUTH_TRUST_HOST=true

# --- Login social (opcional) ---------------------------------------------------
# Se ficarem vazios, os botões de Google/GitHub simplesmente não aparecem.
# Google:  https://console.cloud.google.com/apis/credentials
#   Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub:  https://github.com/settings/developers  → New OAuth App
#   Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Upload de avatar (opcional) -----------------------------------------------
# Vercel → Storage → Blob → crie um store e copie o token.
# Sem ele, o perfil oferece apenas os avatares prontos.
BLOB_READ_WRITE_TOKEN=""

# --- Capas automáticas dos jogos (opcional) ------------------------------------
# Chave gratuita em https://rawg.io/apidocs
# Sem ela, os cards usam uma capa gerada com as cores da plataforma.
RAWG_API_KEY=""

# --- Seed (apenas desenvolvimento) ---------------------------------------------
# Usuário de demonstração criado por `npm run db:seed`.
SEED_EMAIL="demo@listajogos.dev"
SEED_PASSWORD="troque-esta-senha"
